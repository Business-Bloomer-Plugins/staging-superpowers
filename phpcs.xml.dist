<?xml version="1.0"?>
<ruleset name="Staging Superpowers for WooCommerce">
	<description>WordPress Coding Standards for Staging Superpowers for WooCommerce.</description>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<exclude-pattern>/assets/*</exclude-pattern>

	<rule ref="WordPress-Extra"/>

	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
